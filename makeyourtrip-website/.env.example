# MakeYourTrip Inc. — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# Google Tag / Google Tag Manager Configuration
NEXT_PUBLIC_GTM_ID=GTM-NWLQ8FH4

# Google Analytics 4 (GA4) Configuration
# (Admin -> Data Streams -> Web -> Measurement ID: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T1ZTPF270H

# EmailJS Configuration
# Get these from https://www.emailjs.com/
# 1. Create a free account
# 2. Add an Email Service (Gmail, Outlook, etc.)
# 3. Create an Email Template
# 4. Copy your Public Key from Account > General

NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID_HERE
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# ============================================================
# EmailJS Template Variables (use these in your template):
# {{from_name}}     — Traveler's full name
# {{from_email}}    — Traveler's email
# {{phone}}         — Phone / WhatsApp
# {{country}}       — Country
# {{destination}}   — Travel destination
# {{departure}}     — Departure city
# {{travel_date}}   — Travel date
# {{return_date}}   — Return date
# {{travelers}}     — Number of travelers
# {{travel_type}}   — Type of travel
# {{requirements}}  — Additional requirements
# ============================================================
